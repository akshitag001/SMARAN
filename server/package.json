  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }

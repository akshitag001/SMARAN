# Copy to .env and fill in. The server loads it on start.

# Claude drafts the feedback. Without a key (or an `ant auth login` profile),
# Smaran drafts on the server with its built-in rules instead.
ANTHROPIC_API_KEY=

# Required in production: signs mentor sessions. Use a long random string.
SESSION_SECRET=

# Optional
# PORT=8787
# SMARAN_DB=./data/smaran.db
# SMARAN_MODEL=claude-opus-5
# SMARAN_EFFORT=low        # low | medium | high
# SMARAN_AI=off            # always use the built-in drafter
